{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; font-src 'self' https://*.gstatic.com https://*.vercel.com https://*.blob.vercel-storage.com;"
        }
      ]
    }
  ]
}